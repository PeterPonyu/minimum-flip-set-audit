  "name": "inferential_stats",
  "status": "ok",
  "script": "inferential_stats.py",
  "not_official_sota": true,
  "note": "Paired post-hoc inferential statistics computed from the existing on-disk per-record results (results_real/, results_real_longtail/). No new inference, no Ollama, no network, no GPU. Does not create llm_qa_ok.json.",
  "grader": "stored `correct` field (strict word-boundary grader; reproduced 114/114 in regrade_independent.json)",
  "design": "Paired within-question design: the same 38 questions are answered under all three conditions at temperature 0, so condition contrasts are matched-pairs, not independent samples.",
  "methods": {
    "backend": "scipy+statsmodels",
    "significance": "exact McNemar (two-sided exact binomial at p=0.5 on the discordant pairs), alpha=0.05",
    "exact_ci": "95% Clopper-Pearson on the discordant split, mapped onto the paired accuracy difference",
    "bootstrap_ci": "paired percentile bootstrap over question ids, 20000 resamples, seed 20260818",
    "multiplicity": "p-values are unadjusted; with 18 contrasts a Holm/Bonferroni correction would raise the bar further",
    "primary_inference": "The exact McNemar p-value and the exact paired CI govern. At n=18 the percentile bootstrap is anti-conservative (it cannot resolve the discreteness of a handful of discordant pairs) and in places excludes zero where the exact test does not; read it as a spread indicator only, never as a significance claim."
  },
  "alpha": 0.05,
